    {
      "parameters": {
        "jsCode": "// Une la respuesta de DeepSeek con el lead que la originó y descarta respuestas no válidas.\nconst source = $('Un lead por item').all();\nconst out = [];\n$input.all().forEach((item, i) => {\n  const raw = String(item.json.text ?? item.json.output ?? '');\n  let data = null;\n  try { data = JSON.parse(raw); } catch (e) {\n    const m = raw.match(/\\{[\\s\\S]*\\}/);\n    if (m) { try { data = JSON.parse(m[0]); } catch (e2) {} }\n  }\n  if (!data || data['score'] === undefined || data['score'] === null) return;\n  const src = source[i].json;\n  out.push({ json: { ...data, lead_id: src.lead_id } });\n});\nreturn out;\n"
      },
