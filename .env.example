# Supabase (Project Settings -> API). La service role NUNCA va al navegador: sólo la usa el servidor.
SUPABASE_URL=https://xuujbcszciiyebcmagla.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clave compartida entre n8n, el panel y la API Python (cabecera x-api-key). Genera una larga: openssl rand -hex 32
SDR_API_KEY=

# Contraseña para entrar al panel
PANEL_PASSWORD=

# Opcional. URL pública del despliegue si el panel no puede deducirla (p. ej. dominio propio)
# SDR_BASE_URL=https://linkedin-sdr.vercel.app

# Opcional. Si mantienes la protección de Vercel activa, crea un "Protection Bypass for Automation"
# y Vercel expone VERCEL_AUTOMATION_BYPASS_SECRET automáticamente.

# Opcional. Alternativas a guardar las cookies en Ajustes
# LINKEDIN_LI_AT=
# LINKEDIN_JSESSIONID=
# LINKEDIN_PROXY=http://usuario:clave@proxy:puerto
