{
  "manifest_version": 3,
  "name": "Coto SDR · Conector de LinkedIn",
  "description": "Mantiene conectada la sesión de LinkedIn de Enrique con el SDR de The Coto Company.",
  "version": "1.0.1",
  "key": "",
  "permissions": ["cookies", "storage", "alarms", "tabs"],
  "host_permissions": ["https://*.linkedin.com/*", "https://linkedin-sdr.vercel.app/*"],
  "externally_connectable": {
    "matches": ["https://linkedin-sdr.vercel.app/*", "http://localhost:3000/*"]
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Coto SDR", "default_popup": "popup.html" }
}
